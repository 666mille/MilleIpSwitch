#pragma code_page(65001)
#include <windows.h>
#include <commctrl.h>
#include "resource.h"

IDI_APP ICON "milleipswitch.ico"
IDI_DETAIL ICON "milleipswitch_detail.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "milleipswitch.manifest"

IDD_EDITOR DIALOGEX 0, 0, 384, 326
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_APPWINDOW
CAPTION "MilleIpSwitch – Profile"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    LTEXT           "Profile:", IDC_LBL_PROFILES, 7, 7, 100, 8
    LISTBOX         IDC_LIST, 7, 17, 118, 214, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | LBS_OWNERDRAWFIXED | LBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP | WS_BORDER
    PUSHBUTTON      "Neu", IDC_NEW, 7, 235, 38, 14
    PUSHBUTTON      "Kopieren", IDC_DUP, 47, 235, 38, 14
    PUSHBUTTON      "Löschen", IDC_DEL, 87, 235, 38, 14
    PUSHBUTTON      "Nach oben", IDC_UP, 7, 252, 58, 14
    PUSHBUTTON      "Nach unten", IDC_DOWN, 67, 252, 58, 14
    PUSHBUTTON      "Importieren …", IDC_IMPORT, 7, 269, 58, 14
    PUSHBUTTON      "Exportieren …", IDC_EXPORT, 67, 269, 58, 14

    LTEXT           "Profilname:", IDC_LBL_NAME, 135, 9, 58, 8
    EDITTEXT        IDC_NAME, 195, 7, 182, 12, ES_AUTOHSCROLL
    LTEXT           "Adapter:", IDC_LBL_ADAPTER, 135, 25, 58, 8
    COMBOBOX        IDC_ADAPTER, 195, 23, 182, 150, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Aktuelle Einstellungen des Adapters übernehmen", IDC_READCUR, 195, 39, 182, 14
    PUSHBUTTON      "IPv6 …", IDC_IPV6BTN, 195, 57, 89, 14
    PUSHBUTTON      "AutoSwitch …", IDC_AUTOBTN, 288, 57, 89, 14

    GROUPBOX        "IP-Adresse", IDC_GRP_IP, 135, 76, 242, 128
    AUTORADIOBUTTON "IP-Adresse automatisch beziehen (DHCP)", IDC_DHCP, 143, 88, 225, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Folgende IP-Adresse verwenden:", IDC_STATICIP, 143, 100, 225, 10
    LTEXT           "IP-Adresse:", IDC_LBL_IP, 153, 115, 90, 8, WS_GROUP
    CONTROL         "", IDC_IP, "SysIPAddress32", WS_TABSTOP, 250, 113, 118, 13
    LTEXT           "Subnetzmaske:", IDC_LBL_MASK, 153, 131, 90, 8
    CONTROL         "", IDC_MASK, "SysIPAddress32", WS_TABSTOP, 250, 129, 118, 13
    LTEXT           "Standardgateway:", IDC_LBL_GW, 153, 147, 90, 8
    CONTROL         "", IDC_GW, "SysIPAddress32", WS_TABSTOP, 250, 145, 118, 13
    LTEXT           "Weitere IP-Adressen (eine pro Zeile, z. B. 10.0.0.5/8):", IDC_LBL_EXTRA, 153, 162, 215, 8
    EDITTEXT        IDC_EXTRA, 153, 172, 215, 27, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL

    GROUPBOX        "DNS-Server", IDC_GRP_DNS, 135, 208, 242, 72
    AUTORADIOBUTTON "DNS-Serveradresse automatisch beziehen", IDC_DNSAUTO, 143, 220, 225, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Folgende DNS-Serveradressen verwenden:", IDC_DNSMAN, 143, 232, 225, 10
    LTEXT           "Bevorzugter DNS-Server:", IDC_LBL_DNS1, 153, 247, 95, 8, WS_GROUP
    CONTROL         "", IDC_DNS1, "SysIPAddress32", WS_TABSTOP, 250, 245, 118, 13
    LTEXT           "Alternativer DNS-Server:", IDC_LBL_DNS2, 153, 263, 95, 8
    CONTROL         "", IDC_DNS2, "SysIPAddress32", WS_TABSTOP, 250, 261, 118, 13

    CONTROL         "", IDC_FEEDBACK, "Static", SS_OWNERDRAW, 7, 286, 370, 14
    PUSHBUTTON      "Aktivieren", IDC_ACTIVATE, 7, 305, 58, 14
    PUSHBUTTON      "Netzwerkstatus", IDC_STATUSBTN, 67, 305, 58, 14
    CONTROL         "", IDC_LANG, "Button", BS_OWNERDRAW | WS_TABSTOP, 135, 305, 64, 14
    DEFPUSHBUTTON   "OK", IDOK, 215, 305, 52, 14
    PUSHBUTTON      "Schließen", IDCANCEL, 270, 305, 52, 14
    PUSHBUTTON      "Speichern", IDC_APPLY, 325, 305, 52, 14
END

IDD_IPV6 DIALOGEX 0, 0, 300, 190
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "IPv6"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    AUTORADIOBUTTON "IPv6 nicht ändern", IDC_V6_KEEP, 10, 10, 280, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "IPv6 automatisch beziehen", IDC_V6_AUTO, 10, 24, 280, 10
    AUTORADIOBUTTON "Folgende IPv6-Adressen verwenden:", IDC_V6_STATIC, 10, 38, 280, 10
    LTEXT           "Adressen:", IDC_V6_LBL_ADDR, 24, 53, 266, 8, WS_GROUP
    EDITTEXT        IDC_V6_ADDR, 24, 63, 266, 34, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL
    LTEXT           "Standardgateway:", IDC_V6_LBL_GW, 24, 105, 90, 8
    EDITTEXT        IDC_V6_GW, 118, 103, 172, 12, ES_AUTOHSCROLL
    LTEXT           "Bevorzugter DNS-Server:", IDC_V6_LBL_DNS1, 10, 128, 104, 8
    EDITTEXT        IDC_V6_DNS1, 118, 126, 172, 12, ES_AUTOHSCROLL
    LTEXT           "Alternativer DNS-Server:", IDC_V6_LBL_DNS2, 10, 144, 104, 8
    EDITTEXT        IDC_V6_DNS2, 118, 142, 172, 12, ES_AUTOHSCROLL
    LTEXT           "", IDC_V6_HINT, 10, 160, 280, 8
    DEFPUSHBUTTON   "OK", IDOK, 184, 170, 52, 14
    PUSHBUTTON      "Abbrechen", IDCANCEL, 240, 170, 50, 14
END

IDD_AUTOSWITCH DIALOGEX 0, 0, 300, 258
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "AutoSwitch"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    AUTOCHECKBOX    "Dieses Profil automatisch aktivieren", IDC_AS_ENABLE, 10, 10, 280, 10, WS_TABSTOP
    LTEXT           "", IDC_AS_INFO, 24, 24, 266, 64
    GROUPBOX        "Bedingungen", IDC_AS_GRP, 10, 92, 280, 126
    AUTOCHECKBOX    "Das Gateway hat die MAC-Adresse:", IDC_AS_MACCHK, 18, 106, 262, 10, WS_TABSTOP
    EDITTEXT        IDC_AS_MAC, 32, 120, 120, 12, ES_AUTOHSCROLL
    PUSHBUTTON      "Aktuelle übernehmen", IDC_AS_MACCUR, 158, 119, 122, 14
    AUTOCHECKBOX    "Dieser Host antwortet auf Ping:", IDC_AS_PINGCHK, 18, 142, 262, 10, WS_TABSTOP
    EDITTEXT        IDC_AS_PING, 32, 156, 248, 12, ES_AUTOHSCROLL
    AUTOCHECKBOX    "", IDC_AS_ARPCHK, 18, 174, 262, 20, BS_MULTILINE | WS_TABSTOP
    LTEXT           "IP:", IDC_AS_ARPL1, 32, 199, 14, 8
    EDITTEXT        IDC_AS_ARPIP, 48, 197, 84, 12, ES_AUTOHSCROLL
    LTEXT           "MAC:", IDC_AS_ARPL2, 138, 199, 22, 8
    EDITTEXT        IDC_AS_ARPMAC, 162, 197, 80, 12, ES_AUTOHSCROLL
    PUSHBUTTON      "Testen", IDC_AS_ARPTEST, 246, 196, 34, 14
    LTEXT           "", IDC_AS_STATUS, 10, 222, 280, 10
    DEFPUSHBUTTON   "OK", IDOK, 184, 238, 52, 14
    PUSHBUTTON      "Abbrechen", IDCANCEL, 240, 238, 50, 14
END
